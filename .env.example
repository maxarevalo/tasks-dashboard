# Copiá este archivo como .env.local y completá los valores.

# Secreto para firmar la sesión. Generá uno con:  npx auth secret
AUTH_SECRET=

# Necesario para entrar desde otro host (ej. el celular por IP de red local).
AUTH_TRUST_HOST=true

# Conexión a MongoDB (Atlas o local). Incluí el nombre de la base en la URI.
# Si tu red falla al resolver el SRV de mongodb+srv:// (querySrv ENOTFOUND),
# usá el connection string "estándar" de Atlas (Connect > standard connection
# string), que lista los hosts y saltea el lookup de SRV.
MONGODB_URI=

# Login temporal por contraseña única.
APP_PASSWORD=
APP_USER_NAME=Mi cuenta
APP_USER_EMAIL=owner@local

# --- Google OAuth (opcional, para reactivar el login con Google) ---
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

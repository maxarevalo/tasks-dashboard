# Copiá este archivo como .env.local y completá los valores.

# Secreto para firmar la sesión. Generá uno con:  npx auth secret
AUTH_SECRET=

# Necesario para entrar desde otro host (ej. el celular por IP de red local).
AUTH_TRUST_HOST=true

# Conexión a MongoDB (Atlas o local). Incluí el nombre de la base en la URI.
# Si tu red falla al resolver el SRV de mongodb+srv:// (querySrv ENOTFOUND),
# usá el connection string "estándar" de Atlas (Connect > standard connection
# string), que lista los hosts y saltea el lookup de SRV.
MONGODB_URI=

# Login temporal por contraseña única.
APP_PASSWORD=
APP_USER_NAME=Mi cuenta
APP_USER_EMAIL=owner@local

# --- Google OAuth (opcional, para reactivar el login con Google) ---
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- Servidor MCP (Personal › Conexiones IA) ---
# Token fijo para Claude Code / la API (header Authorization: Bearer ...).
# Mínimo 32 caracteres; generalo con: openssl rand -hex 32
MCP_TOKEN=
# Perfil (nombre o key) que usa el token fijo; vacío = el primero.
MCP_PROFILE=
# URL pública de producción (opcional; si falta se toma del request).
APP_URL=
# Zona horaria para "hoy" en las herramientas MCP.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# --- Notificaciones push (vencimientos) ---
# Generá el par de claves UNA vez con: npx web-push generate-vapid-keys
# Si cambiás las claves, los dispositivos tienen que volver a activar las notificaciones.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que se manda a los servicios de push (mailto: o https://).
VAPID_SUBJECT=mailto:tu-mail@ejemplo.com
# Secreto con el que Vercel Cron llama a /api/cron/vencimientos
# (Vercel lo manda solo si la variable existe). Generalo con: openssl rand -hex 32
CRON_SECRET=

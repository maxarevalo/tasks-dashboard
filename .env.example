# Copiá este archivo como .env.local y completá los valores.

# Secreto para firmar la sesión. Generá uno con:  npx auth secret
AUTH_SECRET=

# Credenciales de Google OAuth (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Opcional: restringí el acceso a estas cuentas (separadas por coma).
# Si lo dejás vacío, cualquier cuenta de Google puede ingresar.
ALLOWED_EMAILS=
